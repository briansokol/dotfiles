# Build on each machine that runs the pi adaptive-routing classifier:
#   ollama pull qwen3:4b-instruct
#   ollama create qwen3:4b-instruct-8k -f packages/ollama/qwen3-4b-instruct-8k.Modelfile
# Inherit template and sampling defaults from the base model.
# Pin a small context: classifier prompts are short, and Ollama's VRAM-based
# default (131072 on a 36 GB Mac) would make this 4B model take ~22 GB and
# evict the main coding model on every prompt.
FROM qwen3:4b-instruct
PARAMETER num_ctx 8192
