# Build on each machine that runs Ornith locally for pi:
#   ollama pull ornith-1.5:35b
#   ollama create ornith-1.5:35b-64k -f packages/ollama/ornith-1.5-35b-64k.Modelfile
# Inherit template, tool parser, and sampling defaults from the base model.
# Pin the runtime context to match pi's 65536-token contextWindow. Ollama's
# VRAM-based default (131072 on a 36 GB Mac) leaves no room for the router
# classifier (qwen3:4b-instruct-8k) to stay loaded alongside it.
FROM ornith-1.5:35b
PARAMETER num_ctx 65536
